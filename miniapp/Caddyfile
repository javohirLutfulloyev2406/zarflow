{$ZARFLOW_DOMAIN} {
	encode gzip zstd

	# frame-ancestors must allow Telegram's web client (it embeds the Mini App in an
	# iframe on web.telegram.org/webk.telegram.org/webz.telegram.org) -- a stricter
	# value here breaks the app only inside Telegram, not in a plain browser tab.
	# script-src allows telegram.org for the telegram-web-app.js SDK loaded in index.html.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'"
	}

	@blockedActuator {
		path /actuator/*
		not path /actuator/health
	}
	handle @blockedActuator {
		respond 404
	}

	@swagger path /swagger-ui* /v3/api-docs*
	handle @swagger {
		respond 404
	}

	handle /telegram/webhook* {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /actuator/health {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

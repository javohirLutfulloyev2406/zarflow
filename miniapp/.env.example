# Bot username (without @) used for the "open in Telegram" link shown
# when this app is opened outside Telegram.
VITE_BOT_USERNAME=your_bot_username

# Host of the dev tunnel (e.g. cloudflared) you're testing through.
# Never set this to "*" or leave it unset while using a tunnel.
VITE_DEV_ALLOWED_HOST=your-tunnel-host.trycloudflare.com

# Shows the dev-only "copy raw initData" debug panel. Only has any effect
# when running `npm run dev` (import.meta.env.DEV) — tree-shaken out of
# production builds regardless of this value.
VITE_DEBUG=false

# Copy to .env.prod on the server, fill in real values, then: chmod 600 .env.prod
# Never commit .env.prod -- it holds production secrets.

# Public hostname this deploy answers on (sslip.io for now, e.g. 1-2-3-4.sslip.io).
ZARFLOW_DOMAIN=replace-with-your-domain

# Which GHCR namespace to pull ghcr.io/<owner>/zarflow-backend and zarflow-web from.
GHCR_OWNER=replace-with-your-lowercase-github-username
IMAGE_TAG=latest

POSTGRES_PASSWORD=replace-with-a-long-random-password

TELEGRAM_BOT_TOKEN=000000000:replace-with-a-real-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-token-az09-dash-underscore-only
TELEGRAM_WEBHOOK_URL=https://replace-with-your-domain
ZARFLOW_TELEGRAM_REGISTER_WEBHOOK=true

ZARFLOW_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ZARFLOW_MINI_APP_URL=https://replace-with-your-domain

# Optional: your personal Telegram chat id, for auto-deploy/alert/watchdog messages.
# Leave blank to disable all of that -- it's not required for the app to run.
# Get it by messaging @userinfobot (or @RawDataBot) on Telegram.
ZARFLOW_ADMIN_CHAT_ID=
